# Kept until these peer ranges catch up (`npm ls --all | grep invalid` lists them):
# - @hookform/resolvers wants ajv-formats ^2, the tree has 3
# - tsconfck (vite-tsconfig-paths) wants TypeScript ^5, while @nestjs/cli 12 hoists its own TypeScript 6
# Without it npm enforces these peer ranges when it re-resolves the tree. turbo prune copies this
# file into the Docker builds, so images resolve like local and CI installs.
legacy-peer-deps=true
