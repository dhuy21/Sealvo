{
  "name": "sealvo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema=apps/api/prisma/schema.prisma",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7"
  },
  "lint-staged": {
    "packages/**/*.ts": [
      "prettier --write",
      "bash -c 'npm run lint -w @sealvo/shared'"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.9"
}
