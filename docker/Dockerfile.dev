# One image for the local stack: api, worker, scheduler and web.
# Source is mounted over this image at runtime, so a code change does not rebuild it.
# A new dependency does: rebuild after package.json or the lockfile changes.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

RUN apk add --no-cache openssl
WORKDIR /app
ENV HUSKY=0 \
    NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

COPY . .
RUN npx prisma generate --schema=apps/api/prisma/schema.prisma
