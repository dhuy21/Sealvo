# ─── API Server ───────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ─── Database (Prisma) ────────────────────────────────────
DATABASE_URL="mysql://root:example@localhost:3307/web_db"

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default

# ─── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=

# ─── Google Auth (OAuth) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ─── Google Cloud TTS ────────────────────────────────────
GOOGLE_TTS_PROJECT_ID=
GOOGLE_TTS_CLIENT_EMAIL=
GOOGLE_TTS_PRIVATE_KEY=

# ─── Gemini ──────────────────────────────────────────────
GEMINI_API_KEY=

# ─── AWS SES ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_SES_FROM=
# Staging only: redirect every outgoing email to this address
STAGING_EMAIL_INTERCEPT=

# ─── Feedback ────────────────────────────────────────────
FEEDBACK_RECIPIENT_EMAIL=

# ─── Scheduler ───────────────────────────────────────────
SCHEDULER_API_URL=http://localhost:3001
CRON_SECRET=

# ─── Frontend ────────────────────────────────────────────
# CORS origin + links in emails
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── docker-compose.prod.yml only ────────────────────────
# MySQL container; the compose file builds DATABASE_URL from them (URL-safe password)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=web_db

# ─── Backup (npm run backup:db -w @sealvo/api) ───────────
# Optional S3-compatible bucket, otherwise the dump only stays in apps/api/backups.
# BUCKET_* names here, not AWS_ENDPOINT_URL: the AWS SDK would also send SES email there.
# Credentials: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY if set, else ACCESS_KEY_ID/SECRET_ACCESS_KEY.
# BUCKET_NAME=
# BUCKET_ENDPOINT=
# REGION=auto
# BACKUP_RETENTION=7

# ─── E2E (Playwright, prisma/seed.mjs) ───────────────────
# Seeded account for the protected-page specs: skipped when unset
# E2E_USERNAME=
# E2E_PASSWORD=
# BASE_URL=http://localhost:3000
