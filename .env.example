# ─── API Server ───────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ─── Database (Prisma) ────────────────────────────────────
DATABASE_URL="mysql://root:example@localhost:3307/web_db"

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default

# ─── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google Auth (OAuth) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ─── Google Cloud TTS ────────────────────────────────────
GOOGLE_TTS_PROJECT_ID=
GOOGLE_TTS_CLIENT_EMAIL=
GOOGLE_TTS_PRIVATE_KEY=
GOOGLE_TTS_PRIVATE_KEY_ID=
GOOGLE_TTS_CLIENT_ID=
GOOGLE_TTS_CLIENT_X509_CERT_URL=

# ─── Gemini ──────────────────────────────────────────────
GEMINI_API_KEY=

# ─── AWS SES ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_SES_FROM=
# Staging only: redirect every outgoing email to this address
STAGING_EMAIL_INTERCEPT=

# ─── Feedback ────────────────────────────────────────────
FEEDBACK_RECIPIENT_EMAIL=

# ─── Scheduler ───────────────────────────────────────────
SCHEDULER_API_URL=http://localhost:3001
CRON_SECRET=

# ─── Frontend ────────────────────────────────────────────
# CORS origin + links in emails
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
