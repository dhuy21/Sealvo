# Each line says who reads the variable and whether it is required.
#   Required: the process refuses to start when it is missing or empty.
#   Optional: a blank value counts as unset; the default shown applies.
# API, worker and scheduler each validate their own list at boot (apps/api/src/config/env.validation.ts)
# and refuse to start on a malformed value (URL without http://, unknown NODE_ENV, port that is not a number...).
# Only environment-specific values live here; business rules (token lifetimes, rate limits, timeouts)
# are named constants in the code. Deployed variables: see docs/railway-setup.md.
#
# A value can reuse another one with ${NAME} (expanded by the API, worker, scheduler and docker compose),
# so a value is written once (also expanded by the backup/restore scripts and the Prisma CLI).

# ─── Hosts ──────────────────────────────────────────────
# Machine running docker-compose.dev.yml (MySQL, Redis, RabbitMQ), used by DATABASE_URL, REDIS_HOST, RABBITMQ_HOST
INFRA_HOST=localhost
# Machine running the API and the web app, used by the URLs below (browser-facing: FRONTEND_URL, API_URL)
APP_HOST=localhost

# ─── Runtime ──────────────────────────────────────────────
# Optional (API, worker): development | test | staging | production. Default development
NODE_ENV=development
# Optional (API): listening port, default 3001. Railway sets PORT, which wins.
# Also the host port of docker-compose.prod.yml
API_PORT=3001
# Web port, used below and as the host port of docker-compose.prod.yml (`next dev` / `next start` take -p)
WEB_PORT=3000

# ─── Database ─────────────────────────────────────────────
# MySQL container of docker-compose.dev.yml / docker-compose.prod.yml (URL-safe password: it goes in DATABASE_URL)
MYSQL_ROOT_PASSWORD=example
MYSQL_DATABASE=web_db
# Host port of MySQL, published by docker-compose.dev.yml and docker-compose.prod.yml
MYSQL_PORT=3307
# Required (API, worker)
DATABASE_URL="mysql://root:${MYSQL_ROOT_PASSWORD}@${INFRA_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"

# ─── Redis ────────────────────────────────────────────────
# Optional (API, worker, scheduler). REDIS_URL wins over the REDIS_* parts; with neither, runs without Redis
# REDIS_URL=
REDIS_HOST=${INFRA_HOST}
# Defaults: port 6379, user default. docker-compose.dev.yml publishes REDIS_PORT
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default

# ─── RabbitMQ ─────────────────────────────────────────────
# Optional (API, worker). RABBITMQ_URL wins over the RABBITMQ_* parts; with neither, emails and imports run directly
# RABBITMQ_URL=
RABBITMQ_HOST=${INFRA_HOST}
# Defaults: port 5672, guest / guest. docker-compose.dev.yml creates this user and publishes RABBITMQ_PORT
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Host port of the management UI published by docker-compose.dev.yml, default 15672
RABBITMQ_UI_PORT=15672

# ─── JWT ──────────────────────────────────────────────────
# Required (API)
JWT_ACCESS_SECRET=

# ─── Google Auth (OAuth) ─────────────────────────────────
# Required (API), even when Google login is not used locally: any placeholder works
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required (API), URL: must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://${APP_HOST}:${API_PORT}/auth/google/callback

# ─── Google Cloud TTS ────────────────────────────────────
# Optional (API): all three or none. None disables pronunciation audio
GOOGLE_TTS_PROJECT_ID=
GOOGLE_TTS_CLIENT_EMAIL=
GOOGLE_TTS_PRIVATE_KEY=

# ─── Gemini ──────────────────────────────────────────────
# Optional (API, worker): unset saves words without generated examples
GEMINI_API_KEY=

# ─── AWS SES ─────────────────────────────────────────────
# Required (API, worker). AWS_SES_FROM must be an email address
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_SES_FROM=
# Optional (API, worker), email: with NODE_ENV=staging, every outgoing email goes to this address
STAGING_EMAIL_INTERCEPT=

# ─── Feedback ────────────────────────────────────────────
# Required (API), email
FEEDBACK_RECIPIENT_EMAIL=

# ─── Scheduler ───────────────────────────────────────────
# Required (scheduler), URL
SCHEDULER_API_URL=http://${APP_HOST}:${API_PORT}
# Required (scheduler). Optional on the API, which then answers 503 to the scheduler. Same value on both
CRON_SECRET=

# ─── Frontend ────────────────────────────────────────────
# Optional (API), URL, default http://localhost:3000: CORS origin + links in emails
FRONTEND_URL=http://${APP_HOST}:${WEB_PORT}
# Web (apps/web/src/env.ts), URL the browser calls the API at, default http://localhost:3001 in dev.
# Read when the web server runs, not at build time: required by the production web container
API_URL=http://${APP_HOST}:${API_PORT}

# ─── docker-compose.prod.yml only ────────────────────────
# MYSQL_ROOT_PASSWORD / MYSQL_DATABASE: see Database above (the compose file builds its own DATABASE_URL)
# Host ports: API_PORT, WEB_PORT and MYSQL_PORT above

# ─── Backup (npm run backup:db -w @sealvo/api) ───────────
# Connection: DATABASE_URL, or when it is unset MYSQLHOST/MYSQLPORT/MYSQLUSER
# + MYSQL_ROOT_PASSWORD/MYSQL_DATABASE
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# How long to wait for MySQL to accept connections (ms)
# MYSQL_WAIT_TIMEOUT=30000
# Optional S3-compatible bucket, otherwise the dump only stays in apps/api/backups.
# BUCKET_* names here, not AWS_ENDPOINT_URL: the AWS SDK would also send SES email there.
# AWS_S3_BUCKET_NAME / AWS_DEFAULT_REGION are accepted instead of BUCKET_NAME / REGION.
# Credentials: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY if set, else ACCESS_KEY_ID/SECRET_ACCESS_KEY.
# BUCKET_NAME=
# BUCKET_ENDPOINT=
# REGION=auto
# BACKUP_RETENTION=7

# ─── E2E (Playwright, prisma/seed.mjs) ───────────────────
# Seeded account for the protected-page specs: skipped when unset
# E2E_USERNAME=
# E2E_PASSWORD=
# BASE_URL=http://localhost:3000
