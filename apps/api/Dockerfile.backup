# Build context: repository root. Runs one MySQL backup and exits (Railway cron service).
# Debian slim, not Alpine: default-mysql-client provides mysqldump.

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package-lock.json apps/api/package.json ./
# The scripts only need @aws-sdk/client-s3: install it alone (version range taken from the
# API manifest). npm keeps the monorepo lockfile's versions and integrity for every package
# it does not prune, so this stays lockfile-reproducible without the full API dependency tree.
RUN node -e "const d = require('./package.json').dependencies; require('fs').writeFileSync('package.json', JSON.stringify({ private: true, dependencies: { '@aws-sdk/client-s3': d['@aws-sdk/client-s3'] } }))" \
 && npm install --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends default-mysql-client \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 appgroup && useradd --uid 1001 --gid appgroup --no-create-home appuser

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/api/scripts/ scripts/

RUN mkdir -p /app/backups && chown appuser:appgroup /app/backups
USER appuser

CMD ["node", "scripts/backup-db.mjs"]
