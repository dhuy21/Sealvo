{
  "$schema": "https://turbo.build/schema.json",
  "cacheMaxSize": "1GB",
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "test:e2e": {
      "cache": false,
      "env": ["BASE_URL", "E2E_USERNAME", "E2E_PASSWORD"],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    }
  }
}
