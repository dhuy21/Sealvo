{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "cache": false,
      "env": ["BASE_URL", "E2E_USERNAME", "E2E_PASSWORD"],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    }
  }
}
